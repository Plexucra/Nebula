<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.nebula</groupId>
  <artifactId>npc-bot</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!--
    Eigenständige Deployment-Einheit OHNE Modulabhängigkeit zum Quarkus-Backend
    (Umsetzungskonzept/14_...md, Teil 2 – "20 Prozesse, die sich wie echte
    Spieler über das reguläre WebSocket-Protokoll verhalten"). Plain Java 21,
    kein Quarkus: nur java.net.http.HttpClient (WebSocket-Client, JDK-Bordmittel)
    plus Jackson für die JSON-Umschläge, die 1:1 dem Backend-Protokoll
    (de.nebula.ws.ClientMessage/ServerMessage) entsprechen, hier bewusst
    dupliziert statt importiert.
  -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>npc-bot</finalName>
    <!--
      Der Tempo-Regler des Spiels darf auch für die Bots nur EINE Quelle
      haben (Umsetzungskonzept/15_...md, Auftrag 3): /shared/game-constants.json
      wandert unter "shared/" in den Klassenpfad, von wo GameSpeed.java sie
      liest – dieselbe Datei, die Backend (SharedConstants.java) und Frontend
      (core/shared-constants.ts) verwenden. Das ist eine Datei-, keine
      Modulabhängigkeit; die bewusste Unabhängigkeit vom Quarkus-Backend
      (siehe Kommentar oben) bleibt unberührt.
    -->
    <resources>
      <resource>
        <directory>${project.basedir}/../shared</directory>
        <targetPath>shared</targetPath>
        <includes>
          <include>game-constants.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>de.nebula.npcbot.Bot</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
